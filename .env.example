# Local: API na porta 3001. Produção (build Vercel): ver .env.production
VITE_API_URL=http://localhost:3001
# SITE_URL=https://padaria-lanchonete-vo-lena.com.br
API_PORT=3001
# Opcional — padrao 0.0.0.0 (Docker/cloud). Use 127.0.0.1 se quiser só localhost.
# API_HOST=0.0.0.0

# Senha do painel /admin e das rotas GET/PATCH /api/orders (protecao da lista de pedidos)
ADMIN_PASSWORD=7778
# Opcional — fortifica assinatura do token de sessao (recomendado em producao, valor aleatorio longo)
# ADMIN_TOKEN_SECRET=

# WhatsApp da loja (DDI + DDD + número, só dígitos). Usado no carrinho e promoções.
VITE_WHATSAPP_BUSINESS_NUMBER=5515997298054

# CEP da loja (somente numeros). Melhora faixas do frete no carrinho. Ex.: VITE_STORE_CEP=01310100
# VITE_STORE_CEP=

# Lembrete após ociosidade (ms): sem clique/movimento por este tempo → toast com link WhatsApp.
# VITE_IDLE_WHATSAPP_MS=180000
# Mínimo entre um lembrete e outro (ms).
# VITE_IDLE_WHATSAPP_COOLDOWN_MS=300000

# Opcional: cache do Vite no E: se o C: estiver cheio (senao o Vite ja tenta E:/lanchonete-vite-cache)
# VITE_CACHE_DIR=E:/lanchonete-vite-cache

# Opcional: URL do Webhook do n8n (no n8n: Workflow > Add node > Webhook > POST > copiar URL de producao)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Evolution API — automador WhatsApp (POST /api/webhooks/pedidos-automation)
# EVOLUTION_API_URL=http://evolution-api:8080
# EVOLUTION_INSTANCE=vo-lena
# EVOLUTION_API_KEY=sua_chave_api

# Mercado Pago — checkout online (PIX / cartões). Token em: https://www.mercadopago.com.br/developers/panel/app
# Produção usa credencial de produção; teste usa Access Token TEST-...
# MERCADOPAGO_ACCESS_TOKEN=
# Mesma URL pública do frontend (sem barra final). Produção deve ser HTTPS.
# MERCADOPAGO_FRONTEND_URL=https://padaria-lanchonete-vo-lena.com.br
# Opcional — notificações servidor (URLs HTTPS públicas só em produção)
# MERCADOPAGO_WEBHOOK_URL=https://SUA_API.com/api/webhooks/mercadopago
